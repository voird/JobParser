@model IReadOnlyList<Vacancy>
@{var all=(IReadOnlyList<Vacancy>)ViewBag.AllVacancies;var parsers=(IReadOnlyList<JobParser.Parsers.IVacancyParser>)ViewBag.Parsers;var sources=all.Select(v=>v.Source).Distinct().OrderBy(x=>x).ToList();var parserCities=(IDictionary<string,List<string>>)ViewBag.ParserCities;}
<section class="hero"><div><small>ПАНЕЛЬ УПРАВЛЕНИЯ</small><h1>Мониторинг вакансий</h1><p>CSV-хранилище</p></div><form asp-action="RunAll" method="post">@Html.AntiForgeryToken()<button class="primary">▶ Запустить все парсеры</button></form></section>
@if(TempData["Notice"] is string n){<div class="notice">@n</div>}
<section class="stats"><div><span>Всего вакансий</span><strong>@all.Count</strong></div><div><span>Источников с данными</span><strong>@sources.Count</strong></div><div><span>Парсеров</span><strong>@parsers.Count</strong></div></section>
<section class="panel"><h2>Парсеры</h2><p class="muted">Каждый парсер отдельно для запуска</p><div class="grid">@foreach(var p in parsers){<article class="parser"><div class="tag">@p.Method</div><h3>@p.SiteName</h3><p class="muted"></p><div class="parser-cities"><b>Города в базе:</b> @if(parserCities.TryGetValue(p.SiteName,out var cities)&&cities.Count>0){<span>@string.Join(" · ",cities)</span>}else{<span class="muted">появятся после первого успешного сбора</span>}</div><form asp-action="Run" method="post">@Html.AntiForgeryToken()<input type="hidden" name="parserId" value="@p.Id"/><button class="secondary">Запустить</button></form></article>}</div></section>
<section class="panel"><div class="heading"><div><h2>Найденные вакансии</h2><p class="muted"></p></div><a class="secondary linkbtn" asp-action="Export">↓ Экспорт CSV</a></div>
<form class="filters" method="get"><input name="q" value="@ViewBag.Query" placeholder="Поиск по вакансии или компании"/><select name="source"><option value="">Все источники</option>@foreach(var s in sources){<option value="@s" selected="@(ViewBag.Source==s)">@s</option>}</select><button class="secondary">Фильтровать</button><a asp-action="Index">Сбросить</a></form>
<div class="tablewrap"><table><thead><tr><th>Профессия</th><th>Вакансия</th><th>Компания</th><th>Зарплата</th><th>Источник</th><th>Ссылка</th></tr></thead><tbody>@if(Model.Count==0){<tr><td colspan="6" class="empty">Пока нет вакансий. Запустите парсер.</td></tr>}else{foreach(var v in Model){<tr><td>@v.Profession</td><td><b>@v.Title</b></td><td>@(string.IsNullOrWhiteSpace(v.Company)?"—":v.Company)</td><td>@(string.IsNullOrWhiteSpace(v.Salary)?"Не указана":v.Salary)</td><td>@v.Source</td><td>@if(!string.IsNullOrWhiteSpace(v.Url)){<a href="@v.Url" target="_blank" rel="noopener">Открыть ↗</a>}</td></tr>}}</tbody></table></div></section>