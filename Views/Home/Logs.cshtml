@model IReadOnlyList<JobParser.Models.ParserRunResult>
<section class="hero"><div><small>СИСТЕМНЫЙ ЖУРНАЛ</small><h1>Журнал запусков</h1><p>История последних 500 запусков парсеров</p></div><a class="secondary linkbtn" asp-action="Index">← К вакансиям</a></section>
<section class="panel"><div class="tablewrap"><table><thead><tr><th>Время запуска</th><th>Источник</th><th>Метод</th><th>Статус</th><th>Найдено</th><th>Добавлено</th><th>Время, мс</th><th>Ошибка</th></tr></thead><tbody>
@if(Model.Count==0){<tr><td colspan="8" class="empty">Запусков пока нет.</td></tr>}else{foreach(var x in Model){<tr><td>@x.StartedAt.ToString("dd.MM.yyyy HH:mm:ss")</td><td>@x.Site</td><td>@x.Method</td><td>@x.Status</td><td>@x.Found</td><td>@x.Added</td><td>@x.ElapsedMs</td><td>@x.Error</td></tr>}}
</tbody></table></div></section>
